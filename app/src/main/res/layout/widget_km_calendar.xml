<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/km_card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_km_white_card"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp">

    <!-- Left half: crisp rendered monthly calendar with week numbers & red today badge -->
    <FrameLayout
        android:id="@+id/km_left_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.12"
        android:paddingEnd="6dp">

        <ImageView
            android:id="@+id/km_month_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="月曆"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <!-- Right half: scrollable 14-day system calendar agenda + floating '+' button -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.0"
        android:paddingStart="4dp">

        <ListView
            android:id="@+id/km_agenda_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/km_empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="8dp"
            android:text="點擊此處授權讀取系統行事曆\n即可同步顯示日曆行程"
            android:textColor="#5F6672"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/km_btn_add_event"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="2dp"
            android:background="@drawable/bg_km_plus_circle"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="＋"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>
