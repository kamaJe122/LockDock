<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/shelf_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="0dp">

    <LinearLayout
        android:id="@id/inline_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_frosted_inline"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp">

        <TextView
            android:id="@id/inline_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="📅 鎖屏小工具列"
            android:textColor="#F5FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@id/shelf_inner_box"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:background="@drawable/bg_frosted_shelf"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        android:weightSum="4">

        <LinearLayout
            android:id="@id/slot_0_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="2"
            android:background="@drawable/bg_frosted_pill"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="11dp"
            android:paddingVertical="4dp">

            <TextView
                android:id="@id/slot_0_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#CCFFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@id/slot_0_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="1dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@id/slot_0_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#B8FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@id/slot_1_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="3dp">

            <ImageView
                android:id="@id/slot_1_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Slot 2"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <FrameLayout
            android:id="@id/slot_2_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="3dp">

            <ImageView
                android:id="@id/slot_2_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Slot 3"
                android:scaleType="fitCenter" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
